rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    match /users/{uid}/{allPaths=**} {
      // User uploads are private by default. Public avatars should be exposed
      // through an explicitly designed public-media path with safe metadata.
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if signedIn()
        && request.auth.uid == uid
        && request.resource.size < 25 * 1024 * 1024
        && request.resource.contentType.matches('image/.*|video/.*');
    }

    match /private-media/{conversationId}/{fileName} {
      // Private conversation media remains closed until membership-aware
      // authorization is implemented and tested.
      allow read, write: if false;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
